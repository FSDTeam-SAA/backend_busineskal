PORT=5000
MONGO_DB_URL=mongodb://127.0.0.1:27017/busineskal
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_USER=
EMAIL_PASS=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Keep at 0 for direct access. Set the exact hop count behind a trusted proxy.
TRUST_PROXY_HOPS=0
NODE_ENV=development
